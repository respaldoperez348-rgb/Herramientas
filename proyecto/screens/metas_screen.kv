#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<MetaCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(160)
    padding: dp(14)
    spacing: dp(8)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: 0.12, 0.16, 0.23, 1
    elevation: 3

    # Fila 1: Título y Badge de Estado
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(8)

        MDLabel:
            text: root.titulo
            font_style: "Subtitle1"
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            size_hint_x: 0.65
            shorten: True
            shorten_from: 'right'

        # Badge de estado dinámico
        MDCard:
            size_hint: None, None
            size: dp(90), dp(24)
            radius: [dp(12), dp(12), dp(12), dp(12)]
            md_bg_color: root.color_estado_fondo
            elevation: 0
            
            MDLabel:
                text: root.estado
                font_style: "Caption"
                bold: True
                halign: "center"
                valign: "middle"
                theme_text_color: "Custom"
                text_color: root.color_estado_texto

    # Fila 2: Hábito vinculado y Fecha Límite
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(22)
        spacing: dp(10)

        # Hábito asociado
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            size_hint_x: 0.55

            MDIconButton:
                icon: "tag-outline"
                theme_text_color: "Custom"
                text_color: 0, 0.97, 1, 1
                size_hint: None, None
                size: dp(20), dp(20)
                padding: dp(2)

            MDLabel:
                text: root.nombre_habito
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0, 0.97, 1, 1
                shorten: True
                shorten_from: 'right'

        # Fecha límite
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            size_hint_x: 0.45

            MDIconButton:
                icon: "calendar-clock"
                theme_text_color: "Custom"
                text_color: 0.7, 0.75, 0.85, 1
                size_hint: None, None
                size: dp(20), dp(20)
                padding: dp(2)

            MDLabel:
                text: f"Límite: {root.fecha_limite}"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.7, 0.75, 0.85, 1
                shorten: True
                shorten_from: 'right'

    # Fila 3: Porcentaje y Barra de Progreso (MDProgressBar)
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(34)
        spacing: dp(4)

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(18)

            MDLabel:
                text: "Progreso alcanzado:"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.65, 0.7, 0.8, 1
                size_hint_x: 0.65

            MDLabel:
                text: f"{int(root.progreso_porcentaje)}%"
                font_style: "Subtitle2"
                bold: True
                halign: "right"
                theme_text_color: "Custom"
                text_color: root.color_porcentaje
                size_hint_x: 0.35

        MDProgressBar:
            id: progress_bar
            max: 100
            value: root.progreso_porcentaje
            color: root.color_porcentaje
            size_hint_y: None
            height: dp(8)

    # Fila 4: Acciones rápidas (Incremento, Completar, Eliminar)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        spacing: dp(6)

        MDFillRoundFlatButton:
            text: "+10%"
            font_size: "11sp"
            size_hint_x: 0.22
            size_hint_y: None
            height: dp(28)
            md_bg_color: 0.18, 0.23, 0.32, 1
            text_color: 0, 0.97, 1, 1
            on_release: root.sumar_progreso(10)

        MDFillRoundFlatButton:
            text: "+25%"
            font_size: "11sp"
            size_hint_x: 0.22
            size_hint_y: None
            height: dp(28)
            md_bg_color: 0.18, 0.23, 0.32, 1
            text_color: 0, 0.97, 1, 1
            on_release: root.sumar_progreso(25)

        MDFillRoundFlatButton:
            text: "✓ Completar"
            font_size: "11sp"
            size_hint_x: 0.38
            size_hint_y: None
            height: dp(28)
            md_bg_color: 0.16, 0.73, 0.51, 0.3
            text_color: 0.2, 0.9, 0.6, 1
            on_release: root.completar_meta()

        MDIconButton:
            icon: "trash-can-outline"
            theme_text_color: "Custom"
            text_color: 0.9, 0.3, 0.3, 1
            size_hint: None, None
            size: dp(28), dp(28)
            padding: dp(4)
            on_release: root.eliminar_meta()


<MetasScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.07, 0.09, 0.13, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header Superior
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.92, None
            height: dp(75)
            pos_hint: {'center_x': 0.5, 'top': 0.98}
            spacing: dp(2)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(36)

                MDLabel:
                    text: "Metas de Hábitos"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0, 0.97, 1, 1
                    halign: "left"
                    size_hint_x: 0.7

                MDFillRoundFlatButton:
                    text: "+ Nueva"
                    font_size: "12sp"
                    size_hint: None, None
                    size: dp(90), dp(32)
                    md_bg_color: 0.1, 0.55, 0.9, 1
                    text_color: 1, 1, 1, 1
                    pos_hint: {'center_y': 0.5}
                    on_release: root.mostrar_dialogo_nueva_meta()

            MDLabel:
                text: "Seguimiento por porcentaje de avance y fechas"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.65, 0.7, 0.8, 1
                size_hint_y: None
                height: dp(18)

        # Tarjeta Resumen de Métricas
        MDCard:
            orientation: 'horizontal'
            size_hint: 0.92, None
            height: dp(65)
            pos_hint: {'center_x': 0.5, 'top': 0.86}
            padding: [dp(12), dp(8)]
            spacing: dp(8)
            radius: [dp(12), dp(12), dp(12), dp(12)]
            md_bg_color: 0.12, 0.16, 0.23, 1
            elevation: 2

            # Métrica 1: En Progreso
            BoxLayout:
                orientation: 'vertical'
                halign: "center"
                MDLabel:
                    id: count_en_progreso
                    text: "0"
                    font_style: "H6"
                    bold: True
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0, 0.97, 1, 1
                MDLabel:
                    text: "En Progreso"
                    font_style: "Caption"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.6, 0.65, 0.75, 1

            # Separador vertical
            Widget:
                size_hint: None, 0.7
                width: dp(1)
                pos_hint: {'center_y': 0.5}
                canvas:
                    Color:
                        rgba: 0.25, 0.3, 0.4, 0.6
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Métrica 2: Completadas
            BoxLayout:
                orientation: 'vertical'
                halign: "center"
                MDLabel:
                    id: count_completadas
                    text: "0"
                    font_style: "H6"
                    bold: True
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.16, 0.85, 0.55, 1
                MDLabel:
                    text: "Completadas"
                    font_style: "Caption"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.6, 0.65, 0.75, 1

            # Separador vertical
            Widget:
                size_hint: None, 0.7
                width: dp(1)
                pos_hint: {'center_y': 0.5}
                canvas:
                    Color:
                        rgba: 0.25, 0.3, 0.4, 0.6
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Métrica 3: % Promedio
            BoxLayout:
                orientation: 'vertical'
                halign: "center"
                MDLabel:
                    id: avg_porcentaje
                    text: "0%"
                    font_style: "H6"
                    bold: True
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 1, 0.75, 0.2, 1
                MDLabel:
                    text: "Promedio"
                    font_style: "Caption"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: 0.6, 0.65, 0.75, 1

        # Filtros rápidos (Todas, En progreso, Completadas)
        BoxLayout:
            orientation: 'horizontal'
            size_hint: 0.92, None
            height: dp(34)
            pos_hint: {'center_x': 0.5, 'top': 0.76}
            spacing: dp(8)

            MDFillRoundFlatButton:
                id: btn_filtro_todas
                text: "Todas"
                font_size: "11sp"
                size_hint_x: 0.33
                md_bg_color: (0, 0.7, 0.9, 0.9) if root.filtro_actual == "Todas" else (0.15, 0.19, 0.27, 1)
                text_color: (1, 1, 1, 1) if root.filtro_actual == "Todas" else (0.7, 0.75, 0.85, 1)
                on_release: root.aplicar_filtro("Todas")

            MDFillRoundFlatButton:
                id: btn_filtro_progreso
                text: "En Progreso"
                font_size: "11sp"
                size_hint_x: 0.34
                md_bg_color: (0, 0.7, 0.9, 0.9) if root.filtro_actual == "En progreso" else (0.15, 0.19, 0.27, 1)
                text_color: (1, 1, 1, 1) if root.filtro_actual == "En progreso" else (0.7, 0.75, 0.85, 1)
                on_release: root.aplicar_filtro("En progreso")

            MDFillRoundFlatButton:
                id: btn_filtro_completadas
                text: "Completadas"
                font_size: "11sp"
                size_hint_x: 0.33
                md_bg_color: (0, 0.7, 0.9, 0.9) if root.filtro_actual == "Completado" else (0.15, 0.19, 0.27, 1)
                text_color: (1, 1, 1, 1) if root.filtro_actual == "Completado" else (0.7, 0.75, 0.85, 1)
                on_release: root.aplicar_filtro("Completado")

        # Lista de Metas (ScrollView)
        ScrollView:
            size_hint: 0.92, 0.60
            pos_hint: {'center_x': 0.5, 'y': 0.09}
            effect_cls: ScrollEffect

            GridLayout:
                id: metas_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: [0, dp(4), 0, dp(20)]

        # Barra de Navegación Inferior Móvil
        MDCard:
            size_hint: 1, None
            height: dp(56)
            pos_hint: {'bottom': 1, 'center_x': 0.5}
            md_bg_color: 0.10, 0.13, 0.18, 1
            elevation: 8
            radius: [dp(14), dp(14), 0, 0]
            padding: [dp(4), dp(2)]

            BoxLayout:
                orientation: 'horizontal'

                # Tab 1: Inicio
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "view-dashboard"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('inicio', 'right')
                    MDLabel:
                        text: "Hábitos"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 2: Metas (Activo)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "target"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1
                        pos_hint: {'center_x': 0.5}
                    MDLabel:
                        text: "Metas"
                        font_size: "9sp"
                        bold: True
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1

                # Tab 3: Recordatorios
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "bell-ring"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('recordatorios', 'left')
                    MDLabel:
                        text: "Horarios"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 4: Asistente
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "robot"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('asistente', 'left')
                    MDLabel:
                        text: "Asistente"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
