#:kivy 2.0.0
#:import ScrollEffect kivy.effects.scroll.ScrollEffect
#:import dp kivy.metrics.dp

<DetalleHabitoScreen>:
    md_bg_color: app.bg_app

    BoxLayout:
        orientation: 'horizontal'

        # Sidebar de Navegación Fijo (Izquierda)
        SidebarNav:
            active_item: "inicio"

        # ==========================================
        # 2. CONTENIDO PRINCIPAL: TEMPORIZADOR Y STATS
        # ==========================================
        ScrollView:
            effect_cls: ScrollEffect
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(28), dp(20), dp(32), dp(24)]
                spacing: dp(18)

                # Header con botón atrás, badge de icono, título y opciones
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(54)
                    spacing: dp(14)

                    MDIconButton:
                        icon: "arrow-left"
                        user_font_size: "22sp"
                        theme_text_color: "Custom"
                        text_color: app.text_primary
                        pos_hint: {'center_y': 0.5}
                        on_release: root.volver_atras()

                    # Contenedor del Icono del Hábito
                    MDCard:
                        size_hint: None, None
                        size: dp(44), dp(44)
                        radius: [dp(10), dp(10), dp(10), dp(10)]
                        md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.16)
                        elevation: 0
                        pos_hint: {'center_y': 0.5}

                        MDIcon:
                            icon: root.icono_habito
                            font_size: "22sp"
                            theme_text_color: "Custom"
                            text_color: app.color_acento
                            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

                    # Título y Subtítulo
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        pos_hint: {'center_y': 0.5}

                        MDLabel:
                            text: root.nombre_habito_texto
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_primary

                        MDLabel:
                            text: root.descripcion_habito_texto
                            font_style: "Caption"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary
                            shorten: True
                            shorten_from: 'right'

                    # Opciones de Hábito (...)
                    MDIconButton:
                        icon: "dots-horizontal"
                        user_font_size: "22sp"
                        theme_text_color: "Custom"
                        text_color: app.text_secondary
                        pos_hint: {'center_y': 0.5}

                # Anillo de Temporizador Central
                FloatLayout:
                    size_hint_y: None
                    height: dp(270)

                    # Canvas para anillo circular
                    Widget:
                        id: timer_canvas
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        size_hint: None, None
                        size: dp(240), dp(240)
                        canvas:
                            # Fondo del anillo adaptativo
                            Color:
                                rgba: app.track_bg
                            Line:
                                circle: (self.center_x, self.center_y, dp(105))
                                width: dp(10)
                            # Progreso del anillo en color de acento
                            Color:
                                rgba: app.color_acento
                            Line:
                                circle: (self.center_x, self.center_y, dp(105), 90 - root.angulo_progreso, 90)
                                width: dp(10)
                                cap: 'round'

                    # Texto e iconos dentro del anillo
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: None, None
                        size: dp(200), dp(170)
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                        spacing: dp(3)

                        MDIcon:
                            icon: root.icono_habito
                            font_size: "26sp"
                            theme_text_color: "Custom"
                            text_color: app.color_acento
                            halign: "center"
                            size_hint_y: None
                            height: dp(30)

                        MDLabel:
                            text: root.enfoque_label
                            font_size: "12sp"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary
                            size_hint_y: None
                            height: dp(18)

                        MDLabel:
                            id: display_tiempo
                            text: root.display_tiempo
                            font_size: "40sp"
                            bold: True
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.text_primary
                            size_hint_y: None
                            height: dp(52)

                        MDLabel:
                            text: root.meta_label
                            font_size: "12sp"
                            halign: "center"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary
                            size_hint_y: None
                            height: dp(18)

                # Botones de Acción: Pausar / Iniciar y Finalizar (Sin colapso vertical)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(44)
                    spacing: dp(14)
                    pos_hint: {'center_x': 0.5}
                    size_hint_x: None
                    width: dp(300)

                    MDFillRoundFlatIconButton:
                        icon: "pause" if root.temporizador_activo else "play"
                        text: "Pausar" if root.temporizador_activo else "Iniciar"
                        font_size: "13sp"
                        size_hint: 0.5, 1
                        md_bg_color: app.color_acento
                        text_color: 1, 1, 1, 1
                        icon_color: 1, 1, 1, 1
                        elevation: 0
                        on_release: root.toggle_temporizador()

                    MDFillRoundFlatIconButton:
                        icon: "stop"
                        text: "Finalizar"
                        font_size: "13sp"
                        size_hint: 0.5, 1
                        md_bg_color: app.card_item_bg
                        text_color: app.text_primary
                        icon_color: app.text_primary
                        line_color: app.card_border
                        line_width: 1
                        elevation: 0
                        on_release: root.detener_temporizador()

                # Sección Inferior: Gráfico de Actividad Semanal + Métricas Rápidas
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(170)
                    spacing: dp(16)

                    # Tarjeta Izquierda: Actividad semanal (Gráfico de Barras)
                    MDCard:
                        size_hint_x: 0.64
                        radius: [dp(14), dp(14), dp(14), dp(14)]
                        padding: [dp(18), dp(14), dp(18), dp(14)]
                        spacing: dp(10)
                        orientation: 'vertical'
                        md_bg_color: app.card_bg
                        line_color: app.card_border
                        line_width: 1
                        elevation: 0

                        MDLabel:
                            text: "Actividad semanal"
                            font_style: "Subtitle2"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_primary
                            size_hint_y: None
                            height: dp(20)

                        # Área del Gráfico: Eje Y + 7 Barras (Lun..Dom)
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(12)

                            # Eje Y con líneas de tiempo
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_x: None
                                width: dp(36)
                                spacing: 0
                                MDLabel:
                                    text: "60 min"
                                    font_size: "8sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    text: "45 min"
                                    font_size: "8sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    text: "30 min"
                                    font_size: "8sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    text: "15 min"
                                    font_size: "8sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    text: "0 min"
                                    font_size: "8sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary

                            # 7 Columnas de días
                            BoxLayout:
                                orientation: 'horizontal'
                                spacing: dp(10)

                                # Lun (20 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 0.67
                                    Widget:
                                        size_hint_y: 0.33
                                        canvas:
                                            Color:
                                                rgba: app.color_progreso
                                            RoundedRectangle:
                                                pos: self.pos
                                                size: self.size
                                                radius: [dp(3), dp(3), 0, 0]
                                    MDLabel:
                                        text: "Lun"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Mar (45 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 0.25
                                    Widget:
                                        size_hint_y: 0.75
                                        canvas:
                                            Color:
                                                rgba: app.color_progreso
                                            RoundedRectangle:
                                                pos: self.pos
                                                size: self.size
                                                radius: [dp(3), dp(3), 0, 0]
                                    MDLabel:
                                        text: "Mar"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Mié (30 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 0.5
                                    Widget:
                                        size_hint_y: 0.5
                                        canvas:
                                            Color:
                                                rgba: app.color_progreso
                                            RoundedRectangle:
                                                pos: self.pos
                                                size: self.size
                                                radius: [dp(3), dp(3), 0, 0]
                                    MDLabel:
                                        text: "Mié"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Jue (0 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 1.0
                                    MDLabel:
                                        text: "Jue"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Vie (30 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 0.5
                                    Widget:
                                        size_hint_y: 0.5
                                        canvas:
                                            Color:
                                                rgba: app.color_progreso
                                            RoundedRectangle:
                                                pos: self.pos
                                                size: self.size
                                                radius: [dp(3), dp(3), 0, 0]
                                    MDLabel:
                                        text: "Vie"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Sáb (50 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 0.17
                                    Widget:
                                        size_hint_y: 0.83
                                        canvas:
                                            Color:
                                                rgba: app.color_progreso
                                            RoundedRectangle:
                                                pos: self.pos
                                                size: self.size
                                                radius: [dp(3), dp(3), 0, 0]
                                    MDLabel:
                                        text: "Sáb"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                                # Dom (0 min)
                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(4)
                                    Widget:
                                        size_hint_y: 1.0
                                    MDLabel:
                                        text: "Dom"
                                        font_size: "9sp"
                                        halign: "center"
                                        theme_text_color: "Custom"
                                        text_color: app.text_secondary
                                        size_hint_y: None
                                        height: dp(14)

                    # Tarjeta Derecha: Racha actual & Meta de hoy
                    MDCard:
                        size_hint_x: 0.36
                        radius: [dp(14), dp(14), dp(14), dp(14)]
                        padding: [dp(20), dp(16), dp(20), dp(16)]
                        spacing: dp(14)
                        orientation: 'vertical'
                        md_bg_color: app.card_bg
                        line_color: app.card_border
                        line_width: 1
                        elevation: 0

                        # Fila Racha actual
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(14)
                            pos_hint: {'center_y': 0.5}

                            MDIcon:
                                icon: "fire"
                                font_size: "24sp"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                                size_hint_x: None
                                width: dp(26)
                                pos_hint: {'center_y': 0.5}

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)
                                pos_hint: {'center_y': 0.5}

                                MDLabel:
                                    text: "Racha actual"
                                    font_size: "11sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary

                                MDLabel:
                                    text: root.racha_actual_texto
                                    font_style: "H6"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.text_primary

                        # Fila Meta de hoy
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(14)
                            pos_hint: {'center_y': 0.5}

                            MDIcon:
                                icon: "bullseye-arrow"
                                font_size: "24sp"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                                size_hint_x: None
                                width: dp(26)
                                pos_hint: {'center_y': 0.5}

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: dp(2)
                                pos_hint: {'center_y': 0.5}

                                MDLabel:
                                    text: "Meta de hoy"
                                    font_size: "11sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary

                                MDLabel:
                                    text: root.meta_hoy_texto
                                    font_style: "H6"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.text_primary
