<RegisterScreen>:
    FloatLayout:
        # Fondo moderno oscuro con gradiente
        canvas.before:
            Color:
                rgba: 0.04, 0.06, 0.10, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 0.88, 0.11, 0.28, 0.08
            Ellipse:
                pos: self.width * 0.1, self.height * 0.60
                size: self.width * 0.8, self.width * 0.8

        MDScrollView:
            size_hint: 1, 1
            do_scroll_x: False
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: ["20dp", "16dp", "20dp", "24dp"]
                spacing: "10dp"

                # Cabecera Branding
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: "140dp"
                    spacing: "4dp"

                    MDCard:
                        size_hint: None, None
                        size: "56dp", "56dp"
                        pos_hint: {'center_x': 0.5}
                        radius: [16, 16, 16, 16]
                        md_bg_color: 0.88, 0.11, 0.28, 0.2
                        line_color: 0.88, 0.11, 0.28, 0.5
                        line_width: 1.2
                        elevation: 4
                        
                        AnchorLayout:
                            anchor_x: 'center'
                            anchor_y: 'center'
                            
                            MDIcon:
                                icon: "account-plus"
                                halign: "center"
                                valign: "center"
                                font_size: "30sp"
                                theme_text_color: "Custom"
                                text_color: 1, 0.2, 0.4, 1

                    MDLabel:
                        text: "HabitPulse"
                        font_style: "H4"
                        bold: True
                        halign: "center"
                        size_hint_y: None
                        height: "34dp"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                    MDLabel:
                        text: "Crear Cuenta"
                        font_style: "H6"
                        bold: True
                        halign: "center"
                        size_hint_y: None
                        height: "24dp"
                        theme_text_color: "Custom"
                        text_color: 0.95, 0.2, 0.38, 1

                    MDLabel:
                        text: "Empieza a transformar tus rutinas hoy"
                        font_style: "Caption"
                        halign: "center"
                        size_hint_y: None
                        height: "16dp"
                        theme_text_color: "Custom"
                        text_color: 0.6, 0.65, 0.75, 1

                # Tarjeta Glassmorphism de Registro
                MDCard:
                    orientation: 'vertical'
                    size_hint_x: 1
                    size_hint_y: None
                    height: "360dp"
                    radius: [20, 20, 20, 20]
                    padding: ["16dp", "16dp", "16dp", "16dp"]
                    spacing: "8dp"
                    md_bg_color: 0.08, 0.11, 0.18, 0.75
                    line_color: 1, 1, 1, 0.12
                    line_width: 1
                    elevation: 8

                    MDTextField:
                        id: username
                        hint_text: "Nombre de Usuario"
                        icon_left: "account-outline"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "44dp"
                        font_size: "14sp"
                        line_color_focus: 0.88, 0.11, 0.28, 1
                        hint_text_color_normal: 0.5, 0.55, 0.65, 1
                        hint_text_color_focus: 0.88, 0.11, 0.28, 1

                    MDTextField:
                        id: email
                        hint_text: "Correo Electrónico"
                        icon_left: "email-outline"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "44dp"
                        font_size: "14sp"
                        line_color_focus: 0.88, 0.11, 0.28, 1
                        hint_text_color_normal: 0.5, 0.55, 0.65, 1
                        hint_text_color_focus: 0.88, 0.11, 0.28, 1

                    MDTextField:
                        id: contrasena
                        hint_text: "Contraseña"
                        password: True
                        icon_left: "lock-outline"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "44dp"
                        font_size: "14sp"
                        line_color_focus: 0.88, 0.11, 0.28, 1
                        hint_text_color_normal: 0.5, 0.55, 0.65, 1
                        hint_text_color_focus: 0.88, 0.11, 0.28, 1

                    MDTextField:
                        id: confirmar_contra
                        hint_text: "Confirmar Contraseña"
                        password: True
                        icon_left: "lock-check-outline"
                        mode: "rectangle"
                        size_hint_y: None
                        height: "44dp"
                        font_size: "14sp"
                        line_color_focus: 0.88, 0.11, 0.28, 1
                        hint_text_color_normal: 0.5, 0.55, 0.65, 1
                        hint_text_color_focus: 0.88, 0.11, 0.28, 1

                    MDLabel:
                        id: error_form
                        text: ""
                        font_style: "Caption"
                        halign: "center"
                        size_hint_y: None
                        height: "16dp"
                        theme_text_color: "Custom"
                        text_color: 1, 0.35, 0.35, 1

                    MDFillRoundFlatButton:
                        text: "Crear Cuenta en HabitPulse"
                        font_size: "14sp"
                        bold: True
                        size_hint_x: 1
                        size_hint_y: None
                        height: "46dp"
                        md_bg_color: 0.88, 0.11, 0.28, 1
                        text_color: 1, 1, 1, 1
                        on_release: root.registrar()

                # Enlace inferior para volver al Login
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: "36dp"
                    spacing: "6dp"
                    
                    MDLabel:
                        text: "¿Ya tienes cuenta?"
                        font_style: "Body2"
                        halign: "right"
                        theme_text_color: "Custom"
                        text_color: 0.55, 0.6, 0.7, 1
                    
                    MDTextButton:
                        text: "Inicia Sesión"
                        font_size: "14sp"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 0.88, 0.11, 0.28, 1
                        pos_hint: {"center_y": 0.5}
                        on_release: root.go_back()
