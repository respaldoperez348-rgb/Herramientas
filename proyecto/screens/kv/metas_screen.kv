#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<MetaCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(148)
    padding: [dp(16), dp(12), dp(16), dp(12)]
    spacing: dp(8)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: app.card_item_bg
    line_color: app.card_border
    line_width: 1
    elevation: 0

    # Fila 1: Título y Badge de Estado
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(8)

        MDLabel:
            text: root.titulo
            font_style: "Subtitle1"
            bold: True
            theme_text_color: "Custom"
            text_color: app.text_primary
            size_hint_x: 0.68
            shorten: True
            shorten_from: 'right'

        # Badge de estado dinámico
        MDCard:
            size_hint: None, None
            size: dp(96), dp(24)
            radius: [dp(12), dp(12), dp(12), dp(12)]
            md_bg_color: root.color_estado_fondo
            elevation: 0

            MDLabel:
                text: root.estado
                font_style: "Caption"
                bold: True
                halign: "center"
                valign: "middle"
                theme_text_color: "Custom"
                text_color: root.color_estado_texto

    # Fila 2: Hábito vinculado y Fecha Límite
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(20)
        spacing: dp(10)

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            size_hint_x: 0.55

            MDIcon:
                icon: "tag-outline"
                font_size: "14sp"
                theme_text_color: "Custom"
                text_color: app.color_acento
                size_hint_x: None
                width: dp(18)
                pos_hint: {'center_y': 0.5}

            MDLabel:
                text: root.nombre_habito
                font_style: "Caption"
                bold: True
                theme_text_color: "Custom"
                text_color: app.text_secondary
                shorten: True
                shorten_from: 'right'
                pos_hint: {'center_y': 0.5}

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            size_hint_x: 0.45

            MDIcon:
                icon: "calendar-clock"
                font_size: "14sp"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                size_hint_x: None
                width: dp(18)
                pos_hint: {'center_y': 0.5}

            MDLabel:
                text: f"Límite: {root.fecha_limite}"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                shorten: True
                shorten_from: 'right'
                pos_hint: {'center_y': 0.5}

    # Fila 3: Porcentaje y Barra de Progreso
    BoxLayout:
        orientation: 'vertical'
        size_hint_y: None
        height: dp(32)
        spacing: dp(4)

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(16)

            MDLabel:
                text: "Progreso alcanzado:"
                font_size: "11sp"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                size_hint_x: 0.7

            MDLabel:
                text: f"{int(root.progreso_porcentaje)}%"
                font_size: "12sp"
                bold: True
                halign: "right"
                theme_text_color: "Custom"
                text_color: app.text_primary
                size_hint_x: 0.3

        # Barra de progreso estilizada
        Widget:
            size_hint_y: None
            height: dp(6)
            canvas:
                Color:
                    rgba: 0.12, 0.15, 0.22, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(3), dp(3), dp(3), dp(3)]
                Color:
                    rgba: app.color_progreso if root.progreso_porcentaje > 0 else (0, 0, 0, 0)
                RoundedRectangle:
                    pos: self.pos
                    size: (self.width * (min(100.0, float(root.progreso_porcentaje)) / 100.0), self.height)
                    radius: [dp(3), dp(3), dp(3), dp(3)]

    # Fila 4: Acciones rápidas (Incremento, Completar, Eliminar)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(28)
        spacing: dp(6)

        MDFillRoundFlatButton:
            text: "+10%"
            font_size: "10sp"
            size_hint: None, None
            size: dp(60), dp(24)
            md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.16)
            text_color: app.color_acento
            on_release: root.sumar_progreso(10)

        MDFillRoundFlatButton:
            text: "+25%"
            font_size: "10sp"
            size_hint: None, None
            size: dp(60), dp(24)
            md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.16)
            text_color: app.color_acento
            on_release: root.sumar_progreso(25)

        Widget:

        MDIconButton:
            icon: "check-circle-outline"
            user_font_size: "18sp"
            theme_text_color: "Custom"
            text_color: app.color_progreso
            size_hint: None, None
            size: dp(26), dp(26)
            on_release: root.completar_meta()

        MDIconButton:
            icon: "trash-can-outline"
            user_font_size: "18sp"
            theme_text_color: "Custom"
            text_color: 0.9, 0.35, 0.35, 1
            size_hint: None, None
            size: dp(26), dp(26)
            on_release: root.eliminar_meta()

<MetasScreen>:
    md_bg_color: app.bg_app

    BoxLayout:
        orientation: 'horizontal'

        # Sidebar de Navegación Fijo (Izquierda)
        SidebarNav:
            active_item: "metas"

        # Contenido Principal: Metas
        ScrollView:
            effect_cls: ScrollEffect
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(32), dp(24), dp(36), dp(32)]
                spacing: dp(18)

                # Header Superior
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(52)

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        pos_hint: {'center_y': 0.5}

                        MDLabel:
                            text: "Metas de Hábitos"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_primary

                        MDLabel:
                            text: "Seguimiento por porcentaje de avance y fechas límite"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary

                    MDFillRoundFlatButton:
                        text: "+ Nueva Meta"
                        md_bg_color: app.color_acento
                        text_color: 1, 1, 1, 1
                        font_style: "Button"
                        bold: True
                        pos_hint: {'center_y': 0.5}
                        on_release: root.mostrar_dialogo_nueva_meta()

                # Tarjeta Resumen de Métricas (3 Columnas)
                MDCard:
                    size_hint_y: None
                    height: dp(80)
                    radius: [dp(14), dp(14), dp(14), dp(14)]
                    padding: [dp(20), dp(12), dp(20), dp(12)]
                    md_bg_color: app.card_bg
                    line_color: app.card_border
                    line_width: 1
                    elevation: 0

                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(16)

                        # Métrica 1: En Progreso
                        BoxLayout:
                            orientation: 'vertical'
                            halign: "center"
                            pos_hint: {'center_y': 0.5}
                            MDLabel:
                                id: count_en_progreso
                                text: "0"
                                font_style: "H5"
                                bold: True
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                            MDLabel:
                                text: "En Progreso"
                                font_size: "11sp"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.text_secondary

                        # Métrica 2: Completadas
                        BoxLayout:
                            orientation: 'vertical'
                            halign: "center"
                            pos_hint: {'center_y': 0.5}
                            MDLabel:
                                id: count_completadas
                                text: "0"
                                font_style: "H5"
                                bold: True
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.color_progreso
                            MDLabel:
                                text: "Completadas"
                                font_size: "11sp"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.text_secondary

                        # Métrica 3: % Promedio
                        BoxLayout:
                            orientation: 'vertical'
                            halign: "center"
                            pos_hint: {'center_y': 0.5}
                            MDLabel:
                                id: avg_porcentaje
                                text: "0%"
                                font_style: "H5"
                                bold: True
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.text_primary
                            MDLabel:
                                text: "Promedio Global"
                                font_size: "11sp"
                                halign: "center"
                                theme_text_color: "Custom"
                                text_color: app.text_secondary

                # Filtros rápidos (Todas, En progreso, Completadas)
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(36)
                    spacing: dp(10)

                    MDFillRoundFlatButton:
                        id: btn_filtro_todas
                        text: "Todas"
                        font_size: "11sp"
                        md_bg_color: app.color_acento if root.filtro_actual == "Todas" else (0.12, 0.16, 0.23, 1)
                        text_color: (1, 1, 1, 1) if root.filtro_actual == "Todas" else app.text_secondary
                        on_release: root.aplicar_filtro("Todas")

                    MDFillRoundFlatButton:
                        id: btn_filtro_progreso
                        text: "En Progreso"
                        font_size: "11sp"
                        md_bg_color: app.color_acento if root.filtro_actual == "En progreso" else (0.12, 0.16, 0.23, 1)
                        text_color: (1, 1, 1, 1) if root.filtro_actual == "En progreso" else app.text_secondary
                        on_release: root.aplicar_filtro("En progreso")

                    MDFillRoundFlatButton:
                        id: btn_filtro_completadas
                        text: "Completadas"
                        font_size: "11sp"
                        md_bg_color: app.color_acento if root.filtro_actual == "Completado" else (0.12, 0.16, 0.23, 1)
                        text_color: (1, 1, 1, 1) if root.filtro_actual == "Completado" else app.text_secondary
                        on_release: root.aplicar_filtro("Completado")

                # Contenedor de Tarjetas de Metas
                GridLayout:
                    id: metas_container
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)
