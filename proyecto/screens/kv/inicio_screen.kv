#:kivy 2.0.0
#:import ScrollEffect kivy.effects.scroll.ScrollEffect
#:import dp kivy.metrics.dp

<DayStatusCircle@BoxLayout>:
    day_name: "Lun"
    is_completed: False
    orientation: 'vertical'
    spacing: dp(6)
    size_hint_x: 1
    alignment: 'center'

    MDLabel:
        text: root.day_name
        font_size: "11sp"
        halign: "center"
        theme_text_color: "Custom"
        text_color: app.text_secondary
        size_hint_y: None
        height: dp(16)

    Widget:
        size_hint: None, None
        size: dp(22), dp(22)
        pos_hint: {'center_x': 0.5}
        canvas:
            Color:
                rgba: app.color_progreso if root.is_completed else (0.13, 0.17, 0.25, 1)
            Ellipse:
                pos: self.pos
                size: self.size
            Color:
                rgba: (1, 1, 1, 1) if root.is_completed else (0.25, 0.32, 0.44, 1)
            Line:
                circle: (self.center_x, self.center_y, dp(11))
                width: 1.2 if not root.is_completed else 0.1
        MDIcon:
            icon: "check" if root.is_completed else ""
            font_size: "14sp"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}

<HabitCard>:
    size_hint_y: None
    height: dp(66)
    padding: [dp(14), dp(8), dp(16), dp(8)]
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: app.card_item_bg
    line_color: app.card_border
    line_width: 1
    elevation: 0
    ripple_behavior: True
    on_release: root.ver_detalle()

    BoxLayout:
        orientation: 'horizontal'
        spacing: dp(14)
        pos_hint: {'center_y': 0.5}

        # Checkbox interactivo estilo cuadrado redondeado
        MDIconButton:
            icon: "checkbox-marked" if root.completado_hoy else "checkbox-blank-outline"
            theme_text_color: "Custom"
            text_color: app.color_progreso if root.completado_hoy else (0.42, 0.48, 0.58, 1)
            size_hint: None, None
            size: dp(36), dp(36)
            user_font_size: "22sp"
            pos_hint: {'center_y': 0.5}
            on_release: root.toggle_check()

        # Nombre del hábito
        MDLabel:
            text: root.nombre
            font_style: "Subtitle1"
            bold: True
            theme_text_color: "Custom"
            text_color: app.text_primary
            size_hint_x: 0.32
            shorten: True
            shorten_from: 'right'
            pos_hint: {'center_y': 0.5}

        # Sección de progreso: Fracción + Barra de progreso
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.45
            spacing: dp(4)
            pos_hint: {'center_y': 0.5}

            MDLabel:
                text: root.progreso_texto
                font_size: "11sp"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                size_hint_y: None
                height: dp(14)

            # Barra de progreso estilizada
            Widget:
                size_hint_y: None
                height: dp(6)
                canvas:
                    Color:
                        rgba: 0.12, 0.15, 0.22, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(3), dp(3), dp(3), dp(3)]
                    Color:
                        rgba: app.color_progreso if root.progreso_porcentaje > 0 else (0, 0, 0, 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: (self.width * (root.progreso_porcentaje / 100.0), self.height)
                        radius: [dp(3), dp(3), dp(3), dp(3)]

        # Icono de categoría y porcentaje
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: 0.18
            spacing: dp(8)
            pos_hint: {'center_y': 0.5}

            MDIcon:
                icon: root.icono
                font_size: "18sp"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                size_hint_x: None
                width: dp(22)
                pos_hint: {'center_y': 0.5}

            MDLabel:
                text: root.porcentaje_label
                font_size: "12sp"
                bold: True
                halign: "right"
                theme_text_color: "Custom"
                text_color: app.text_primary
                pos_hint: {'center_y': 0.5}

<InicioScreen>:
    md_bg_color: app.bg_app

    BoxLayout:
        orientation: 'horizontal'

        # Sidebar de Navegación Fijo (Izquierda)
        SidebarNav:
            active_item: "inicio"

        # ==========================================
        # 2. CONTENIDO PRINCIPAL (DASHBOARD)
        # ==========================================
        ScrollView:
            effect_cls: ScrollEffect
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(32), dp(24), dp(36), dp(32)]
                spacing: dp(20)

                # Saludo Header
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(60)
                    spacing: dp(2)

                    MDLabel:
                        id: bienvenido
                        text: "Buenos días, David"
                        font_style: "H4"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.text_primary

                    MDLabel:
                        text: "Un pequeño avance cada día"
                        font_style: "Subtitle2"
                        theme_text_color: "Custom"
                        text_color: app.text_secondary

                # Tarjeta: Tu progreso semanal
                MDCard:
                    size_hint_y: None
                    height: dp(190)
                    radius: [dp(16), dp(16), dp(16), dp(16)]
                    padding: [dp(24), dp(18), dp(24), dp(18)]
                    spacing: dp(14)
                    orientation: 'vertical'
                    md_bg_color: app.card_bg
                    line_color: app.card_border
                    line_width: 1
                    elevation: 0

                    # Título y Porcentaje
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(24)

                        MDLabel:
                            text: "Tu progreso semanal"
                            font_style: "Subtitle1"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_primary

                        MDLabel:
                            id: progreso_general_porcentaje
                            text: "68%"
                            font_style: "H6"
                            bold: True
                            halign: "right"
                            theme_text_color: "Custom"
                            text_color: app.text_primary

                    # Barra de progreso semanal
                    Widget:
                        size_hint_y: None
                        height: dp(10)
                        canvas:
                            Color:
                                rgba: 0.12, 0.15, 0.22, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(5), dp(5), dp(5), dp(5)]
                            Color:
                                rgba: app.color_progreso
                            RoundedRectangle:
                                pos: self.pos
                                size: (self.width * 0.68, self.height)
                                radius: [dp(5), dp(5), dp(5), dp(5)]

                    # Fila de días Lun - Dom con checks
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(48)
                        spacing: dp(8)

                        DayStatusCircle:
                            day_name: "Lun"
                            is_completed: True

                        DayStatusCircle:
                            day_name: "Mar"
                            is_completed: True

                        DayStatusCircle:
                            day_name: "Mié"
                            is_completed: True

                        DayStatusCircle:
                            day_name: "Jue"
                            is_completed: False

                        DayStatusCircle:
                            day_name: "Vie"
                            is_completed: True

                        DayStatusCircle:
                            day_name: "Sáb"
                            is_completed: True

                        DayStatusCircle:
                            day_name: "Dom"
                            is_completed: False

                    # Fila de 3 estadísticas: Racha, Enfoque y Hábitos
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(38)
                        spacing: dp(16)

                        # Stat 1: Racha
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(10)
                            size_hint_x: 0.33

                            MDIcon:
                                icon: "fire"
                                font_size: "22sp"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                                size_hint_x: None
                                width: dp(24)
                                pos_hint: {'center_y': 0.5}

                            BoxLayout:
                                orientation: 'vertical'
                                pos_hint: {'center_y': 0.5}
                                MDLabel:
                                    text: "Racha"
                                    font_size: "10sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    id: racha_header
                                    text: "5 días"
                                    font_style: "Subtitle2"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.text_primary

                        # Stat 2: Enfoque
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(10)
                            size_hint_x: 0.33

                            MDIcon:
                                icon: "bullseye-arrow"
                                font_size: "22sp"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                                size_hint_x: None
                                width: dp(24)
                                pos_hint: {'center_y': 0.5}

                            BoxLayout:
                                orientation: 'vertical'
                                pos_hint: {'center_y': 0.5}
                                MDLabel:
                                    text: "Enfoque"
                                    font_size: "10sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    id: tiempo
                                    text: "75 min"
                                    font_style: "Subtitle2"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.text_primary

                        # Stat 3: Hábitos
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: dp(10)
                            size_hint_x: 0.33

                            MDIcon:
                                icon: "layers-outline"
                                font_size: "22sp"
                                theme_text_color: "Custom"
                                text_color: app.color_acento
                                size_hint_x: None
                                width: dp(24)
                                pos_hint: {'center_y': 0.5}

                            BoxLayout:
                                orientation: 'vertical'
                                pos_hint: {'center_y': 0.5}
                                MDLabel:
                                    text: "Hábitos"
                                    font_size: "10sp"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary
                                MDLabel:
                                    id: sesiones
                                    text: "3/4"
                                    font_style: "Subtitle2"
                                    bold: True
                                    theme_text_color: "Custom"
                                    text_color: app.text_primary

                # Cabecera Sección: Hábitos de hoy + Botón Nuevo Hábito
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(42)

                    MDLabel:
                        text: "Hábitos de hoy"
                        font_style: "H6"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.text_primary
                        pos_hint: {'center_y': 0.5}

                    MDFillRoundFlatButton:
                        text: "+ Nuevo hábito"
                        md_bg_color: app.color_acento
                        text_color: 1, 1, 1, 1
                        font_style: "Button"
                        bold: True
                        pos_hint: {'center_y': 0.5}
                        on_release: root.add_new_habit()

                # Contenedor de Tarjetas de Hábitos
                GridLayout:
                    id: habits_container
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)
