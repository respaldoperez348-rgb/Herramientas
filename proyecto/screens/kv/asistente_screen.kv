#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<AlertaRiesgoCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(148)
    padding: [dp(16), dp(12), dp(16), dp(12)]
    spacing: dp(6)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.12)
    line_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.35)
    line_width: 1
    elevation: 0

    # Header de Alerta con porcentaje crítico
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(8)

        MDIcon:
            icon: "alert-decagram"
            font_size: "18sp"
            theme_text_color: "Custom"
            text_color: app.color_acento
            size_hint_x: None
            width: dp(20)
            pos_hint: {'center_y': 0.5}

        MDLabel:
            text: f"Riesgo de Abandono: {root.nombre_habito}"
            font_style: "Subtitle2"
            bold: True
            theme_text_color: "Custom"
            text_color: app.color_acento
            size_hint_x: 0.65
            shorten: True
            shorten_from: 'right'
            pos_hint: {'center_y': 0.5}

        MDLabel:
            text: f"{int(root.porcentaje_cumplimiento)}% cumplido"
            font_size: "11sp"
            bold: True
            halign: "right"
            theme_text_color: "Custom"
            text_color: app.text_primary
            size_hint_x: 0.35
            pos_hint: {'center_y': 0.5}

    # Diagnóstico del auditor
    MDLabel:
        text: root.diagnostico
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: app.text_primary
        size_hint_y: None
        height: dp(26)
        shorten: True
        shorten_from: 'right'

    # Recomendación Contextual
    MDCard:
        size_hint_y: None
        height: dp(34)
        radius: [dp(8), dp(8), dp(8), dp(8)]
        md_bg_color: app.card_item_bg
        padding: [dp(10), dp(4)]
        elevation: 0

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)

            MDIcon:
                icon: "lightbulb-on-outline"
                font_size: "14sp"
                theme_text_color: "Custom"
                text_color: app.color_progreso
                size_hint_x: None
                width: dp(16)
                pos_hint: {'center_y': 0.5}

            MDLabel:
                text: root.recomendacion
                font_size: "10sp"
                theme_text_color: "Custom"
                text_color: app.text_secondary
                shorten: True
                shorten_from: 'right'
                pos_hint: {'center_y': 0.5}

    # Botones de Acción Rápida (Reajustar y Horario)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(8)

        MDFillRoundFlatButton:
            text: "Reajustar Meta (-50%)"
            font_size: "10sp"
            size_hint: None, None
            size: dp(150), dp(24)
            md_bg_color: app.color_acento
            text_color: 1, 1, 1, 1
            on_release: root.accion_reajustar()

        MDFillRoundFlatButton:
            text: "Ajustar Horario"
            font_size: "10sp"
            size_hint: None, None
            size: dp(115), dp(24)
            md_bg_color: (0.12, 0.16, 0.23, 1)
            text_color: app.text_secondary
            on_release: root.accion_recordatorio()

<MensajeChatWidget>:
    orientation: 'horizontal'
    size_hint_y: None
    height: self.minimum_height
    padding: [dp(4), dp(2)]
    spacing: dp(8)

    # Espacio para alinear a derecha si es usuario
    Widget:
        size_hint_x: 0.25 if root.es_usuario else 0.001

    MDCard:
        size_hint_x: 0.75
        size_hint_y: None
        height: self.minimum_height
        radius: [dp(14), dp(14), 0, dp(14)] if root.es_usuario else [dp(14), dp(14), dp(14), 0]
        md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.22) if root.es_usuario else app.card_item_bg
        line_color: app.color_acento if root.es_usuario else app.card_border
        line_width: 1
        padding: [dp(14), dp(10), dp(14), dp(10)]
        elevation: 0

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(16)
                spacing: dp(6)

                MDIcon:
                    icon: "account" if root.es_usuario else "robot"
                    font_size: "12sp"
                    theme_text_color: "Custom"
                    text_color: app.color_acento if root.es_usuario else app.color_progreso
                    size_hint_x: None
                    width: dp(14)
                    pos_hint: {'center_y': 0.5}

                MDLabel:
                    text: "Tú" if root.es_usuario else "Asistente HabitPulse"
                    font_size: "10sp"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: app.text_secondary

            MDLabel:
                text: root.texto
                font_size: "12sp"
                theme_text_color: "Custom"
                text_color: app.text_primary
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

    # Espacio para alinear a izquierda si es bot
    Widget:
        size_hint_x: 0.25 if not root.es_usuario else 0.001

<AsistenteScreen>:
    md_bg_color: app.bg_app

    BoxLayout:
        orientation: 'horizontal'

        # Sidebar de Navegación Fijo (Izquierda)
        SidebarNav:
            active_item: "asistente"

        # Contenido Principal: Asistente & Chat
        BoxLayout:
            orientation: 'vertical'
            padding: [dp(32), dp(24), dp(36), dp(24)]
            spacing: dp(14)

            # Header Superior
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(50)

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(2)
                    pos_hint: {'center_y': 0.5}

                    MDLabel:
                        text: "Asistente Contextual"
                        font_style: "H4"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: app.text_primary

                    MDLabel:
                        text: "Detección de riesgo de abandono (<50%) y coaching guiado"
                        font_style: "Subtitle2"
                        theme_text_color: "Custom"
                        text_color: app.text_secondary

                # Chip de Estado IA
                MDCard:
                    size_hint: None, None
                    size: dp(120), dp(32)
                    radius: [dp(16), dp(16), dp(16), dp(16)]
                    md_bg_color: (app.color_progreso[0], app.color_progreso[1], app.color_progreso[2], 0.16)
                    elevation: 0
                    pos_hint: {'center_y': 0.5}

                    MDLabel:
                        text: "● Auditor 7-14d"
                        font_size: "11sp"
                        bold: True
                        halign: "center"
                        valign: "middle"
                        theme_text_color: "Custom"
                        text_color: app.color_progreso

            # Área de Alertas de Riesgo (si las hay)
            BoxLayout:
                id: contenedor_alertas_riesgo
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

            # Chips de Preguntas Frecuentes Rápidas
            ScrollView:
                size_hint_y: None
                height: dp(34)
                do_scroll_y: False
                do_scroll_x: True

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_x: None
                    width: self.minimum_width
                    spacing: dp(8)

                    MDFillRoundFlatButton:
                        text: "📊 ¿Qué hábito está en riesgo?"
                        font_size: "10sp"
                        md_bg_color: (0.12, 0.16, 0.23, 1)
                        text_color: app.text_primary
                        on_release: root.enviar_consulta_rapida("¿Qué hábito está en riesgo de abandono?")

                    MDFillRoundFlatButton:
                        text: "🎯 Reajustar metas"
                        font_size: "10sp"
                        md_bg_color: (0.12, 0.16, 0.23, 1)
                        text_color: app.text_primary
                        on_release: root.enviar_consulta_rapida("¿Cómo reajusto mis metas para no desertar?")

                    MDFillRoundFlatButton:
                        text: "🔥 Salvar racha"
                        font_size: "10sp"
                        md_bg_color: (0.12, 0.16, 0.23, 1)
                        text_color: app.text_primary
                        on_release: root.enviar_consulta_rapida("¿Cómo recupero mi racha si fallé un día?")

                    MDFillRoundFlatButton:
                        text: "⚡ Regla de 2 min"
                        font_size: "10sp"
                        md_bg_color: (0.12, 0.16, 0.23, 1)
                        text_color: app.text_primary
                        on_release: root.enviar_consulta_rapida("Explícame la regla de los 2 minutos")

            # Historial del Chat (ScrollView)
            ScrollView:
                id: scroll_asistente
                effect_cls: ScrollEffect
                do_scroll_x: False

                BoxLayout:
                    id: contenedor_chat
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)
                    padding: [0, dp(6), 0, dp(10)]

            # Barra de Entrada de Chat Interactiva
            MDCard:
                size_hint_y: None
                height: dp(48)
                radius: [dp(24), dp(24), dp(24), dp(24)]
                md_bg_color: app.card_bg
                line_color: app.card_border
                line_width: 1
                padding: [dp(16), dp(4)]
                elevation: 0

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(8)

                    TextInput:
                        id: campo_chat_mensaje
                        hint_text: "Pregúntale algo al Asistente..."
                        font_size: "13sp"
                        multiline: False
                        size_hint_x: 0.88
                        background_color: 0, 0, 0, 0
                        foreground_color: app.text_primary
                        cursor_color: app.color_acento
                        hint_text_color: app.text_secondary
                        padding: [dp(4), dp(10)]
                        on_text_validate: root.enviar_mensaje()

                    MDIconButton:
                        icon: "send"
                        theme_text_color: "Custom"
                        text_color: app.color_acento
                        size_hint: None, None
                        size: dp(40), dp(40)
                        pos_hint: {'center_y': 0.5}
                        on_release: root.enviar_mensaje()
