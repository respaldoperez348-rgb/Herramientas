#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<RecordatorioCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(145)
    padding: [dp(16), dp(12), dp(16), dp(12)]
    spacing: dp(8)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: app.card_item_bg
    line_color: app.card_border
    line_width: 1
    elevation: 0

    # Fila 1: Hábito, Hora y MDSwitch
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        spacing: dp(10)

        # Nombre del hábito con icono
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(8)
            size_hint_x: 0.50

            MDIcon:
                icon: "clock-outline"
                font_size: "20sp"
                theme_text_color: "Custom"
                text_color: app.color_acento if root.activo else app.text_secondary
                size_hint_x: None
                width: dp(22)
                pos_hint: {'center_y': 0.5}

            MDLabel:
                text: root.nombre_habito
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: app.text_primary if root.activo else app.text_secondary
                shorten: True
                shorten_from: 'right'
                pos_hint: {'center_y': 0.5}

        # Hora programada en formato reloj
        MDLabel:
            text: root.hora
            font_style: "H6"
            bold: True
            halign: "right"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: app.color_progreso if root.activo else app.text_secondary
            size_hint_x: 0.30
            pos_hint: {'center_y': 0.5}

        # Switch interactivo MDSwitch
        MDSwitch:
            id: switch_activo
            active: root.activo
            size_hint: None, None
            size: dp(48), dp(28)
            pos_hint: {'center_y': 0.5}
            on_active: root.toggle_switch(self, self.active)

    # Fila 2: Mensaje Motivacional
    MDLabel:
        text: f'"{root.mensaje}"' if root.mensaje else "Recordatorio diario programado"
        font_style: "Caption"
        italic: True
        theme_text_color: "Custom"
        text_color: app.text_secondary
        size_hint_y: None
        height: dp(20)
        shorten: True
        shorten_from: 'right'

    # Fila 3: Chips de Días de la Semana (Lun, Mar, Mié, etc.)
    BoxLayout:
        id: dias_container
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(6)

    # Fila 4: Acciones (Probar notificación y Eliminar)
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(10)

        MDFillRoundFlatButton:
            text: "Probar Alarma"
            font_size: "10sp"
            size_hint: None, None
            size: dp(110), dp(24)
            md_bg_color: (app.color_acento[0], app.color_acento[1], app.color_acento[2], 0.16)
            text_color: app.color_acento
            on_release: root.probar_alarma()

        Widget:

        MDIconButton:
            icon: "trash-can-outline"
            user_font_size: "18sp"
            theme_text_color: "Custom"
            text_color: 0.9, 0.35, 0.35, 1
            size_hint: None, None
            size: dp(26), dp(26)
            on_release: root.eliminar_recordatorio()

<RecordatoriosScreen>:
    md_bg_color: app.bg_app

    BoxLayout:
        orientation: 'horizontal'

        # Sidebar de Navegación Fijo (Izquierda)
        SidebarNav:
            active_item: "recordatorios"

        # Contenido Principal: Recordatorios
        ScrollView:
            effect_cls: ScrollEffect
            do_scroll_x: False

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [dp(32), dp(24), dp(36), dp(32)]
                spacing: dp(18)

                # Header Superior
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(52)

                    BoxLayout:
                        orientation: 'vertical'
                        spacing: dp(2)
                        pos_hint: {'center_y': 0.5}

                        MDLabel:
                            text: "Horarios y Recordatorios"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_primary

                        MDLabel:
                            text: "Alertas y notificaciones para consistencia en tus rutinas"
                            font_style: "Subtitle2"
                            theme_text_color: "Custom"
                            text_color: app.text_secondary

                    MDFillRoundFlatButton:
                        text: "+ Programar"
                        md_bg_color: app.color_acento
                        text_color: 1, 1, 1, 1
                        font_style: "Button"
                        bold: True
                        pos_hint: {'center_y': 0.5}
                        on_release: root.mostrar_dialogo_nuevo_recordatorio()

                # Banner de Estado de Notificaciones
                MDCard:
                    size_hint_y: None
                    height: dp(70)
                    radius: [dp(14), dp(14), dp(14), dp(14)]
                    padding: [dp(20), dp(12), dp(20), dp(12)]
                    md_bg_color: app.card_bg
                    line_color: app.card_border
                    line_width: 1
                    elevation: 0

                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(14)
                        pos_hint: {'center_y': 0.5}

                        MDIcon:
                            icon: "bell-ring-outline"
                            font_size: "26sp"
                            theme_text_color: "Custom"
                            text_color: app.color_acento
                            size_hint_x: None
                            width: dp(30)
                            pos_hint: {'center_y': 0.5}

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(2)
                            pos_hint: {'center_y': 0.5}

                            MDLabel:
                                id: texto_recordatorios_activos
                                text: "0 recordatorios activos hoy"
                                font_style: "Subtitle1"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.text_primary

                            MDLabel:
                                text: "Las alarmas emitirán alertas sonoras y visuales según la frecuencia fijada"
                                font_size: "11sp"
                                theme_text_color: "Custom"
                                text_color: app.text_secondary

                # Contenedor de Tarjetas de Recordatorios
                GridLayout:
                    id: recordatorios_container
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)
