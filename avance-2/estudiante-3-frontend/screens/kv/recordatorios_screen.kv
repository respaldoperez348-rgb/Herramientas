#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<RecordatorioCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(155)
    padding: dp(14)
    spacing: dp(8)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: 0.12, 0.16, 0.23, 1
    elevation: 3

    # Fila 1: Hábito, Hora y MDSwitch
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(32)
        spacing: dp(10)

        # Nombre del hábito con icono
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)
            size_hint_x: 0.50

            MDIconButton:
                icon: "clock-outline"
                theme_text_color: "Custom"
                text_color: (0, 0.97, 1, 1) if root.activo else (0.5, 0.55, 0.65, 1)
                size_hint: None, None
                size: dp(26), dp(26)
                padding: dp(2)

            MDLabel:
                text: root.nombre_habito
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1) if root.activo else (0.7, 0.75, 0.85, 1)
                shorten: True
                shorten_from: 'right'

        # Hora programada en formato reloj
        MDLabel:
            text: root.hora
            font_style: "H6"
            bold: True
            halign: "right"
            valign: "middle"
            theme_text_color: "Custom"
            text_color: (0, 0.97, 1, 1) if root.activo else (0.5, 0.55, 0.65, 1)
            size_hint_x: 0.30

        # Switch interactivo MDSwitch
        MDSwitch:
            id: switch_activo
            active: root.activo
            size_hint: None, None
            size: dp(40), dp(26)
            pos_hint: {'center_y': 0.5}
            on_active: root.cambiar_estado_switch(self.active)

    # Fila 2: Mensaje personalizado del recordatorio
    MDCard:
        size_hint_y: None
        height: dp(42)
        radius: [dp(8), dp(8), dp(8), dp(8)]
        md_bg_color: (0.16, 0.20, 0.28, 1) if root.activo else (0.13, 0.15, 0.20, 1)
        padding: [dp(10), dp(6)]
        elevation: 0

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)

            MDIconButton:
                icon: "message-text-outline"
                theme_text_color: "Custom"
                text_color: (0.8, 0.6, 1, 1) if root.activo else (0.5, 0.5, 0.5, 1)
                size_hint: None, None
                size: dp(20), dp(20)
                padding: dp(2)

            MDLabel:
                text: root.mensaje if root.mensaje else "¡Es momento de cumplir tu hábito diario!"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: (0.9, 0.9, 0.95, 1) if root.activo else (0.55, 0.6, 0.65, 1)
                shorten: True
                shorten_from: 'right'

    # Fila 3: Días de la semana y botón eliminar
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(30)
        spacing: dp(8)

        # Chips de días: L, M, M, J, V, S, D
        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(4)
            size_hint_x: 0.85

            MDLabel:
                text: f"Días: {root.dias_semana}"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: (0.16, 0.85, 0.55, 1) if root.activo else (0.5, 0.55, 0.65, 1)
                bold: True
                shorten: True
                shorten_from: 'right'

        MDIconButton:
            icon: "trash-can-outline"
            theme_text_color: "Custom"
            text_color: 0.9, 0.3, 0.3, 1
            size_hint: None, None
            size: dp(28), dp(28)
            padding: dp(4)
            on_release: root.eliminar_recordatorio()


<RecordatoriosScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.07, 0.09, 0.13, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header Superior
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.92, None
            height: dp(75)
            pos_hint: {'center_x': 0.5, 'top': 0.98}
            spacing: dp(2)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(36)

                MDLabel:
                    text: "Recordatorios"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0, 0.97, 1, 1
                    halign: "left"
                    size_hint_x: 0.68

                MDFillRoundFlatButton:
                    text: "+ Programar"
                    font_size: "12sp"
                    size_hint: None, None
                    size: dp(105), dp(32)
                    md_bg_color: 0.1, 0.55, 0.9, 1
                    text_color: 1, 1, 1, 1
                    pos_hint: {'center_y': 0.5}
                    on_release: root.mostrar_dialogo_nuevo_recordatorio()

            MDLabel:
                text: "Horarios y alertas para consistencia en tus rutinas"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.65, 0.7, 0.8, 1
                size_hint_y: None
                height: dp(18)

        # Banner de Estado de Notificaciones
        MDCard:
            orientation: 'horizontal'
            size_hint: 0.92, None
            height: dp(60)
            pos_hint: {'center_x': 0.5, 'top': 0.86}
            padding: [dp(14), dp(8)]
            spacing: dp(10)
            radius: [dp(12), dp(12), dp(12), dp(12)]
            md_bg_color: 0.12, 0.16, 0.23, 1
            elevation: 2

            MDIconButton:
                icon: "bell-ring-outline"
                theme_text_color: "Custom"
                text_color: 0, 0.97, 1, 1
                size_hint: None, None
                size: dp(36), dp(36)
                pos_hint: {'center_y': 0.5}

            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.75
                pos_hint: {'center_y': 0.5}

                MDLabel:
                    id: texto_recordatorios_activos
                    text: "0 recordatorios activos hoy"
                    font_style: "Subtitle2"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1

                MDLabel:
                    text: "Las alarmas sonarán según la frecuencia establecida"
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: 0.6, 0.65, 0.75, 1

        # Lista de Recordatorios (ScrollView)
        ScrollView:
            size_hint: 0.92, 0.68
            pos_hint: {'center_x': 0.5, 'y': 0.09}
            effect_cls: ScrollEffect

            GridLayout:
                id: recordatorios_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: [0, dp(6), 0, dp(24)]

        # Barra de Navegación Inferior Móvil
        MDCard:
            size_hint: 1, None
            height: dp(56)
            pos_hint: {'bottom': 1, 'center_x': 0.5}
            md_bg_color: 0.10, 0.13, 0.18, 1
            elevation: 8
            radius: [dp(14), dp(14), 0, 0]
            padding: [dp(4), dp(2)]

            BoxLayout:
                orientation: 'horizontal'

                # Tab 1: Inicio
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "view-dashboard"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('inicio', 'right')
                    MDLabel:
                        text: "Hábitos"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 2: Metas
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "target"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('metas', 'right')
                    MDLabel:
                        text: "Metas"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 3: Recordatorios (Activo)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "bell-ring"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1
                        pos_hint: {'center_x': 0.5}
                    MDLabel:
                        text: "Horarios"
                        font_size: "9sp"
                        bold: True
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1

                # Tab 4: Asistente
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "robot"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('asistente', 'left')
                    MDLabel:
                        text: "Asistente"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
