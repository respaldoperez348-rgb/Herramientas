#:kivy 2.0.0
#:import dp kivy.metrics.dp
#:import ScrollEffect kivy.effects.scroll.ScrollEffect

<AlertaRiesgoCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(165)
    padding: dp(14)
    spacing: dp(8)
    radius: [dp(12), dp(12), dp(12), dp(12)]
    md_bg_color: 0.22, 0.13, 0.15, 1
    elevation: 3

    # Fila 1: Header de Alerta con porcentaje crítico
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(26)
        spacing: dp(6)

        MDIconButton:
            icon: "alert-decagram"
            theme_text_color: "Custom"
            text_color: 1, 0.4, 0.4, 1
            size_hint: None, None
            size: dp(24), dp(24)
            padding: dp(2)

        MDLabel:
            text: f"Riesgo: {root.nombre_habito}"
            font_style: "Subtitle2"
            bold: True
            theme_text_color: "Custom"
            text_color: 1, 0.4, 0.4, 1
            size_hint_x: 0.65
            shorten: True
            shorten_from: 'right'

        MDLabel:
            text: f"{int(root.porcentaje_cumplimiento)}% cumplido"
            font_style: "Caption"
            bold: True
            halign: "right"
            theme_text_color: "Custom"
            text_color: 1, 0.75, 0.2, 1
            size_hint_x: 0.35

    # Fila 2: Diagnóstico del auditor de 7-14 días
    MDLabel:
        text: root.diagnostico
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: 0.85, 0.85, 0.9, 1
        size_hint_y: None
        height: dp(28)

    # Fila 3: Recomendación Contextual
    MDCard:
        size_hint_y: None
        height: dp(50)
        radius: [dp(8), dp(8), dp(8), dp(8)]
        md_bg_color: 0.16, 0.12, 0.18, 1
        padding: [dp(8), dp(4)]
        elevation: 0

        BoxLayout:
            orientation: 'horizontal'
            spacing: dp(6)

            MDIconButton:
                icon: "lightbulb-on-outline"
                theme_text_color: "Custom"
                text_color: 1, 0.85, 0.2, 1
                size_hint: None, None
                size: dp(20), dp(20)
                padding: dp(2)

            MDLabel:
                text: root.recomendacion
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 1, 0.9, 0.7, 1

    # Fila 4: Botones de Acción
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(28)
        spacing: dp(8)

        MDFillRoundFlatButton:
            text: "Reajustar Meta"
            font_size: "10sp"
            size_hint_x: 0.5
            size_hint_y: None
            height: dp(26)
            md_bg_color: 0.9, 0.3, 0.3, 0.85
            text_color: 1, 1, 1, 1
            on_release: root.accion_reajustar()

        MDFillRoundFlatButton:
            text: "Crear Alerta"
            font_size: "10sp"
            size_hint_x: 0.5
            size_hint_y: None
            height: dp(26)
            md_bg_color: 0.18, 0.24, 0.35, 1
            text_color: 0, 0.97, 1, 1
            on_release: root.accion_recordatorio()


<MensajeChatWidget>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(6)
    spacing: dp(2)

    MDCard:
        size_hint_x: 0.88
        size_hint_y: None
        height: self.minimum_height
        pos_hint: {'right': 0.98} if root.es_usuario else {'x': 0.02}
        radius: [dp(14), dp(14), dp(2), dp(14)] if root.es_usuario else [dp(14), dp(14), dp(14), dp(2)]
        md_bg_color: (0.1, 0.45, 0.75, 1) if root.es_usuario else (0.14, 0.18, 0.26, 1)
        padding: [dp(12), dp(10)]
        elevation: 2

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)

            # Nombre remitente
            MDLabel:
                text: "Tú" if root.es_usuario else "🤖 Asistente Contextual"
                font_style: "Caption"
                bold: True
                theme_text_color: "Custom"
                text_color: (0.7, 0.9, 1, 1) if root.es_usuario else (0, 0.97, 1, 1)
                size_hint_y: None
                height: dp(14)

            # Texto del mensaje
            MDLabel:
                text: root.texto
                font_style: "Body2"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None


<AsistenteScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.07, 0.09, 0.13, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # Header Superior
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.92, None
            height: dp(75)
            pos_hint: {'center_x': 0.5, 'top': 0.98}
            spacing: dp(2)

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(36)

                MDLabel:
                    text: "Asistente Contextual"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0, 0.97, 1, 1
                    halign: "left"
                    size_hint_x: 0.7

                # Chip de Estado IA
                MDCard:
                    size_hint: None, None
                    size: dp(100), dp(28)
                    radius: [dp(14), dp(14), dp(14), dp(14)]
                    md_bg_color: 0.16, 0.73, 0.51, 0.2
                    elevation: 0
                    pos_hint: {'center_y': 0.5}

                    MDLabel:
                        text: "● Auditor 7-14d"
                        font_size: "10sp"
                        bold: True
                        halign: "center"
                        valign: "middle"
                        theme_text_color: "Custom"
                        text_color: 0.16, 0.85, 0.55, 1

            MDLabel:
                text: "Prevención de deserción (<50%) y motivación guiada"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.65, 0.7, 0.8, 1
                size_hint_y: None
                height: dp(18)

        # Contenedor con Scroll para Auditoría y Chat
        ScrollView:
            id: scroll_asistente
            size_hint: 0.92, 0.70
            pos_hint: {'center_x': 0.5, 'y': 0.14}
            effect_cls: ScrollEffect

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(14)
                padding: [0, dp(4), 0, dp(15)]

                # Sección 1: Título Auditoría
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(24)
                    spacing: dp(6)

                    MDIconButton:
                        icon: "radar"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1
                        size_hint: None, None
                        size: dp(24), dp(24)
                        padding: dp(2)

                    MDLabel:
                        text: "Auditoría de Deserción Reciente"
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                # Contenedor dinámico de alertas de riesgo (< 50%)
                BoxLayout:
                    id: contenedor_alertas_riesgo
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                # Sección 2: Título Chat Interactivo
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(24)
                    spacing: dp(6)

                    MDIconButton:
                        icon: "chat-processing-outline"
                        theme_text_color: "Custom"
                        text_color: 0.8, 0.6, 1, 1
                        size_hint: None, None
                        size: dp(24), dp(24)
                        padding: dp(2)

                    MDLabel:
                        text: "Interacción y Asesoría Guiada"
                        font_style: "Subtitle2"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1

                # Chips de Preguntas Frecuentes Rápidas
                ScrollView:
                    size_hint_y: None
                    height: dp(36)
                    do_scroll_y: False
                    do_scroll_x: True

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_x: None
                        width: self.minimum_width
                        spacing: dp(6)

                        MDFillRoundFlatButton:
                            text: "📊 ¿Qué hábito está en riesgo?"
                            font_size: "10sp"
                            md_bg_color: 0.16, 0.20, 0.28, 1
                            text_color: 0, 0.97, 1, 1
                            on_release: root.enviar_consulta_rapida("¿Qué hábito está en riesgo de abandono?")

                        MDFillRoundFlatButton:
                            text: "🎯 Reajustar metas"
                            font_size: "10sp"
                            md_bg_color: 0.16, 0.20, 0.28, 1
                            text_color: 0, 0.97, 1, 1
                            on_release: root.enviar_consulta_rapida("¿Cómo reajusto mis metas para no desertar?")

                        MDFillRoundFlatButton:
                            text: "🔥 Salvar racha"
                            font_size: "10sp"
                            md_bg_color: 0.16, 0.20, 0.28, 1
                            text_color: 0, 0.97, 1, 1
                            on_release: root.enviar_consulta_rapida("¿Cómo recupero mi racha si fallé un día?")

                        MDFillRoundFlatButton:
                            text: "⚡ Regla de 2 min"
                            font_size: "10sp"
                            md_bg_color: 0.16, 0.20, 0.28, 1
                            text_color: 0, 0.97, 1, 1
                            on_release: root.enviar_consulta_rapida("Explícame la regla de los 2 minutos")

                # Contenedor del Historial del Chat
                BoxLayout:
                    id: contenedor_chat
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)

        # Barra de Entrada de Chat Interactiva
        MDCard:
            size_hint: 0.92, None
            height: dp(48)
            pos_hint: {'center_x': 0.5, 'y': 0.08}
            radius: [dp(24), dp(24), dp(24), dp(24)]
            md_bg_color: 0.14, 0.18, 0.25, 1
            padding: [dp(12), dp(2)]
            elevation: 4

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(6)

                TextInput:
                    id: campo_chat_mensaje
                    hint_text: "Pregúntale algo al Asistente..."
                    font_size: "13sp"
                    multiline: False
                    size_hint_x: 0.82
                    background_color: 0, 0, 0, 0
                    foreground_color: 1, 1, 1, 1
                    cursor_color: 0, 0.97, 1, 1
                    hint_text_color: 0.6, 0.65, 0.75, 1
                    padding: [dp(4), dp(12)]
                    on_text_validate: root.enviar_mensaje()

                MDIconButton:
                    icon: "send"
                    theme_text_color: "Custom"
                    text_color: 0, 0.97, 1, 1
                    size_hint: None, None
                    size: dp(40), dp(40)
                    pos_hint: {'center_y': 0.5}
                    on_release: root.enviar_mensaje()

        # Barra de Navegación Inferior Móvil
        MDCard:
            size_hint: 1, None
            height: dp(56)
            pos_hint: {'bottom': 1, 'center_x': 0.5}
            md_bg_color: 0.10, 0.13, 0.18, 1
            elevation: 8
            radius: [dp(14), dp(14), 0, 0]
            padding: [dp(4), dp(2)]

            BoxLayout:
                orientation: 'horizontal'

                # Tab 1: Inicio
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "view-dashboard"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('inicio', 'right')
                    MDLabel:
                        text: "Hábitos"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 2: Metas
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "target"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('metas', 'right')
                    MDLabel:
                        text: "Metas"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 3: Recordatorios
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "bell-ring"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1
                        pos_hint: {'center_x': 0.5}
                        on_release: root.app.cambiar_pantalla('recordatorios', 'right')
                    MDLabel:
                        text: "Horarios"
                        font_size: "9sp"
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0.5, 0.55, 0.65, 1

                # Tab 4: Asistente (Activo)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.25
                    spacing: 0
                    MDIconButton:
                        icon: "robot"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1
                        pos_hint: {'center_x': 0.5}
                    MDLabel:
                        text: "Asistente"
                        font_size: "9sp"
                        bold: True
                        halign: "center"
                        theme_text_color: "Custom"
                        text_color: 0, 0.97, 1, 1
